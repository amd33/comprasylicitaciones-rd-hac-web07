  <script>
       $.ajax({
            type: "POST",
            url: "movimientos.php",
            data: { nrocontratacion: $('#nropliego').val(),
                    ano: $('#anopliego').val(),
                    tipo: $('#tipo').val(),
            },
            success: function(data){
              console.log(data);

                $('#movimientos').html(data);

            },
          error: function(data)
          {
            alert("error");
          }
          });

      $( ".pagos" ).fadeIn();





          $.ajax({
            type: "POST",
            url: "getinfopliego.php",
            data: { nropliego: $('#nropliego').val(),
                    ano: $('#anopliego').val(),
                    tipo: $('#tipo').val(), },
            success: function(data){
              console.log(data);
              var response = data.split(",");
              if (data==0) {
                  swal("¡Error!", "¡No disponible o fecha límite de compra vencida! ", "error")
                 
              }else{
                $('#exampleModalCenter').modal('show')
                $('#objeto').text(response["1"]);
                $('#presupuesto').val(response["2"]);
                $('#valorpliego').val(response["0"]);
                // $('#nropliego').val(response["3"]);
                // $('#nropliego').val(response["4"]);
                // $('#nropliego').val(response["5"]);

              }


            },
          error: function(data)
          {
            swal("¡Error!", "¡Error Nº1233!  ", "success")
          }
          });



      $(".link").click(function() {
        var preco = Math.trunc($('#valorpliego').val());
        $.ajax({
          type: "POST",
          url: "generarecibo.php",
          data: { numerodeproveedor: $('#numerodeproveedor').val() , lici: $('#nropliego').val(),valor: preco },
          success: function(response)
          {
            console.log(response);
              var form_data = {
              recibo: response,
              };
              $.ajax({
                  type: "POST",
                  url: "getInforRecibo.php",
                  data: form_data,
                  success: function(response)
                  {
                      //console.log(response);
                      var response = response.split(",");
                      var tasa = "COMPRA DE PLIEGOS";
                      var cuenta= $("#numerodeproveedor").val();
                      var razon= $("#numerodeproveedor").val();
                      var recibo= response["2"];
                      var fvenci= response["3"];
                      var total= Math.trunc($('#valorpliego').val());
                      var mail='';
                      var retorno='www.vicentelopez.gov.ar';
                      linkParam(tasa, cuenta, razon, recibo, fvenci, total, fvenci, total, retorno);
                  },
                  error: function(response)
                  {

                  }
                });
          },
          error: function(response)
          {

          }
        });




    })

