  <script>




      $( ".fin" ).hide();
     $(".acepto").click(function() {
      $( ".fin" ).fadeIn();
      $( ".inicio" ).hide();

    })


    $(document).on("click",".borrar",function(event){
        let this_tr = $(this).closest('tr');
        let idpliego = this_tr.data("idpliego");
        let tipo = this_tr.data("tipo");
        let nroproveedor = this_tr.data("nroproveedor");
        let anopliego = this_tr.data("anopliego");

       
        if ( confirm('Esta seguro de borrar el registro?') ){
            $.ajax({
                type: "POST",
                url: "borrarProvPliego.php",
                data: {
                    idpliego:idpliego,
                    tipo:tipo,
                    nroproveedor:nroproveedor,
                    anopliego:anopliego
                },
                success: function(response){
                 
                
                alert('El proveedor está habilitado para volver a comprar esta licitación.');
                    location.reload();
                },
                error: function(response)
                {
                alert("error");
                }
            });
          }
    });


$(document).ready(function () {

$('#pliegos').DataTable({
  dom: 'Bfrtip',
 
});




$.ajax({
  type: 'POST',
  url: "getprovPliegos.php",
  success: function(response){
    $('#pliegos').DataTable().destroy();
    $('#tbodypliegos').html(response);
    $('#pliegos').DataTable({
      "scrollX": true,
      //dom: 'Bfrtip',
      
    });
  }
});

$( ".bandeja" ).addClass( "menu-open" );
$( ".bandeja" ).addClass( "active" );  
$( ".consulta-entidades" ).addClass( "active" ); 


});



function getFormData(id,data)
      {
          $("#"+id).find("input,select").each(function(i,v) {
              if(v.type!=="file") {
                  if(v.type==="checkbox" && v.checked===true) {
                      data.append(v.name,"on");
                  }else{
                      data.append(v.name,v.value);
                  }
              }
          });
          return data;
      }



function filtro()
{

    var tecla = event.key;
    if (['.','e'].includes(tecla))
        event.preventDefault()
}



